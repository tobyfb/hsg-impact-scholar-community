---
import Base from "../layouts/Base.astro";
import { render } from "astro:content";
import { getPage, getSite } from "../lib/content";

const page = await getPage("get-involved");
const { Content } = await render(page);
const site = await getSite();
---

<Base title={page.data.title} description={page.data.description} current="/get-involved/">
  <div class="wrap page-head">
    <h1>{page.data.title}</h1>
    {page.data.lead && <p class="lead">{page.data.lead}</p>}
  </div>
  <div class="wrap">
    <div class="prose"><Content /></div>
  </div>

  <section class="wrap section" id="contact" aria-labelledby="contact-title">
    <div class="band">
      <div>
        <h2 id="contact-title">Contact</h2>
        <p>
          Write to the facilitators at <a href={`mailto:${site.email}`} style="color: var(--yellow)">{site.email}</a>.
          {site.linkedinUrl && <>You can also find us in the <a href={site.linkedinUrl} style="color: var(--yellow)">LinkedIn group</a>.</>}
        </p>
      </div>
      <p>
        <a class="btn" href={`mailto:${site.email}`}>Send an email</a>
      </p>
    </div>
  </section>
</Base>
