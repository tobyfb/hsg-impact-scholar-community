---
import Base from "../layouts/Base.astro";
import { render } from "astro:content";
import { getPage, getMembers } from "../lib/content";

const page = await getPage("people");
const { Content } = await render(page);
const members = await getMembers();

const groups = [
  { id: "facilitators", title: "Facilitators", list: members.filter((m) => m.data.group === "facilitator") },
  { id: "alumni", title: "Former facilitators", list: members.filter((m) => m.data.group === "alumni") },
  { id: "supporters", title: "Collaborators and supporters", list: members.filter((m) => m.data.group === "supporter") },
].filter((group) => group.list.length > 0);

// "Facilitator since 2024", "Facilitator 2021–2023", "Facilitator until 2023"
const facilitatorLine = (m: (typeof members)[number]["data"]) => {
  if (m.group === "supporter") return undefined;
  const { facilitatorFrom: from, facilitatorUntil: until } = m;
  if (m.group === "facilitator") return from ? `Facilitator since ${from}` : undefined;
  if (from && until) return from === until ? `Facilitator ${from}` : `Facilitator ${from}–${until}`;
  if (until) return `Facilitator until ${until}`;
  return from ? `Facilitator from ${from}` : undefined;
};

const initials = (name: string) =>
  name
    .split(/\s+/)
    .map((part) => part[0])
    .filter((_, i, all) => i === 0 || i === all.length - 1)
    .join("");

const rendered = await Promise.all(
  members.map(async (member) => [member.id, (await render(member)).Content] as const),
);
const bios = new Map(rendered);
---

<Base title={page.data.title} description={page.data.description} current="/people/">
  <div class="wrap page-head">
    <h1>{page.data.title}</h1>
    {page.data.lead && <p class="lead">{page.data.lead}</p>}
  </div>

  {
    groups.map((group) => (
      <section class="wrap section--tight" aria-labelledby={group.id}>
        <h2 id={group.id}>{group.title}</h2>
        <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr))">
          {group.list.map((member) => {
            const m = member.data;
            const Bio = bios.get(member.id)!;
            const community = [m.roleNote, facilitatorLine(m)].filter(Boolean).join(" · ");
            const links = [
              m.links.profile && { href: m.links.profile, label: "HSG profile" },
              m.links.website && { href: m.links.website, label: "Website" },
              m.links.linkedin && { href: m.links.linkedin, label: "LinkedIn" },
              m.links.bluesky && { href: m.links.bluesky, label: "Bluesky" },
              m.links.scholar && { href: m.links.scholar, label: "Google Scholar" },
              m.links.orcid && { href: m.links.orcid, label: "ORCID" },
            ].filter(Boolean) as { href: string; label: string }[];
            return (
              <article class="person" id={member.id}>
                {m.photo ? (
                  <img class="person__photo" src={m.photo} alt={`Portrait of ${m.name}`} width="104" height="104" loading="lazy" />
                ) : (
                  <div class="person__photo" aria-hidden="true">{initials(m.name)}</div>
                )}
                <div>
                  {!m.consent && <p class="person__draft">Draft, not yet confirmed</p>}
                  <h3>{m.name}</h3>
                  <p>
                    {m.position && `${m.position}, `}
                    {m.unitUrl ? <a href={m.unitUrl}>{m.unit}</a> : m.unit}
                    {community && <br />}
                    {community && <span class="muted">{community}</span>}
                  </p>
                  <Bio />
                  {m.researchInterests && (
                    <>
                      <p class="person__label">Research interests</p>
                      <p>{m.researchInterests}</p>
                    </>
                  )}
                  {m.methods.length > 0 && (
                    <>
                      <p class="person__label">Methods</p>
                      <ul class="chips chips--methods">{m.methods.map((item) => <li>{item}</li>)}</ul>
                    </>
                  )}
                  {links.length > 0 && (
                    <p style="margin-top: 0.9rem">
                      {links.map((link, i) => (
                        <>
                          {i > 0 && " · "}
                          <a href={link.href}>{link.label}</a>
                        </>
                      ))}
                    </p>
                  )}
                </div>
              </article>
            );
          })}
        </div>
      </section>
    ))
  }

  <section class="wrap section--tight">
    <div class="prose"><Content /></div>
  </section>
</Base>
